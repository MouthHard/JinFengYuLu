# ===========================================
# 数据库配置
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=website_user
DB_PASSWORD=你的MySQL密码
DB_DATABASE=personal_website

# ===========================================
# 服务器配置
# ===========================================
PORT=3000
NODE_ENV=development

# 生产环境 CORS 允许的前端域名（多个用逗号分隔）
# 生产环境必须设置此变量，否则后端启动会报错
CORS_ORIGIN=http://your-server-ip,https://your-domain.com

# ===========================================
# JWT 配置（暂未使用，保留）
# ===========================================
# 生产环境请用 openssl rand -hex 32 生成随机密钥
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h
